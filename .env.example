# Copy these into Vercel → Project → Settings → Environment Variables.
# Never commit real values to GitHub.

# ElevenLabs (required for audio)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Optional. Defaults to eleven_v4. Use eleven_flash_v2_5 if you want it faster/cheaper.
ELEVENLABS_MODEL_ID=eleven_v4

# Anthropic / Claude (writes the journal lines and screens bad input).
# Optional: without it, entries come from built-in templates.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Vercel Blob storage. Added automatically when you connect a Blob store.
BLOB_READ_WRITE_TOKEN=

# Your secret password for /admin (make it long and random)
ADMIN_TOKEN=

# Safety valves
SUBMISSIONS_OPEN=true
MAX_ENTRIES_PER_DAY=400
TIMEZONE=America/New_York

# Shown on the site as the creator credit
CREATOR_NAME=
PORTFOLIO_URL=
