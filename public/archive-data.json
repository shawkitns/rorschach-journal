{
 "frozenAt": "2026-11-01T04:28:44.305Z",
 "mapKey": "Solid red: where I walked, recorded by GPS. Dashed: the parade route up Sixth Avenue, walked after 7 PM, when the GPS record was lost. Pins: entries, placed where I was when they were written.",
 "routeLabel": "Parade route · GPS lost after 7 PM",
 "entries": [
  {
   "id": "8206512795675-tqxclp",
   "createdAt": "2026-10-31T22:53:24.324Z",
   "stamp": "Rorschach's journal. October 31st. 18:53.",
   "line": "Raymond sees a giraffe. Long neck, looks down on everyone, and hasn't said a word in the group chat since 2019. Case closed, Raymond, you're a giraffe with a read receipt.",
   "text": "Rorschach's journal. October 31st. 18:53. Raymond sees a giraffe. Long neck, looks down on everyone, and hasn't said a word in the group chat since 2019. Case closed, Raymond, you're a giraffe with a read receipt.",
   "audioUrl": "/archive-audio/8206512795675-tqxclp.mp3"
  },
  {
   "id": "8206516119949-rd4whn",
   "createdAt": "2026-10-31T21:58:00.050Z",
   "stamp": "Rorschach's journal. October 31st. 17:58.",
   "line": "Kelvin sees a shark. Can't stop moving or it dies, and circles the same Hinge matches all week. Jaws needed a bigger boat. Kelvin needs a bigger commitment.",
   "text": "Rorschach's journal. October 31st. 17:58. Kelvin sees a shark. Can't stop moving or it dies, and circles the same Hinge matches all week. Jaws needed a bigger boat. Kelvin needs a bigger commitment.",
   "audioUrl": "/archive-audio/8206516119949-rd4whn.mp3"
  },
  {
   "id": "8206516127845-rzvg11",
   "createdAt": "2026-10-31T21:57:52.154Z",
   "stamp": "Rorschach's journal. October 31st. 17:57.",
   "line": "Ray saw something the journal won't read out on a public street. Bold choice for a stranger's inkblot. Ray's file just got thicker.",
   "text": "Rorschach's journal. October 31st. 17:57. Ray saw something the journal won't read out on a public street. Bold choice for a stranger's inkblot. Ray's file just got thicker.",
   "audioUrl": "/archive-audio/8206516127845-rzvg11.mp3"
  },
  {
   "id": "8206516532228-rp8s4i",
   "createdAt": "2026-10-31T21:51:07.771Z",
   "stamp": "Rorschach's journal. October 31st. 17:51.",
   "line": "J sees two dogs, nose to nose, perfectly matched. Case note: this one is shopping for a pair. Both dogs have already left J on read.",
   "text": "Rorschach's journal. October 31st. 17:51. J sees two dogs, nose to nose, perfectly matched. Case note: this one is shopping for a pair. Both dogs have already left J on read.",
   "audioUrl": "/archive-audio/8206516532228-rp8s4i.mp3"
  },
  {
   "id": "8206516972548-ovzgin",
   "createdAt": "2026-10-31T21:43:47.451Z",
   "stamp": "Rorschach's journal. October 31st. 17:43.",
   "line": "Drew sees a fire mask. Firefighters wear those to run into burning buildings. Drew, the building is your ex's apartment, and you still have a key.",
   "text": "Rorschach's journal. October 31st. 17:43. Drew sees a fire mask. Firefighters wear those to run into burning buildings. Drew, the building is your ex's apartment, and you still have a key.",
   "audioUrl": "/archive-audio/8206516972548-ovzgin.mp3"
  },
  {
   "id": "8206517212821-rj5y53",
   "createdAt": "2026-10-31T21:39:47.178Z",
   "stamp": "Rorschach's journal. October 31st. 17:39.",
   "line": "Duke sees the devil. Contract on the table, signature line already filled in. Case note: this one has never read the fine print. Not once.",
   "text": "Rorschach's journal. October 31st. 17:39. Duke sees the devil. Contract on the table, signature line already filled in. Case note: this one has never read the fine print. Not once.",
   "audioUrl": "/archive-audio/8206517212821-rj5y53.mp3"
  },
  {
   "id": "8206517216947-c3ork6",
   "createdAt": "2026-10-31T21:39:43.052Z",
   "stamp": "Rorschach's journal. October 31st. 17:39.",
   "line": "JT sees an animal skull. Hollow, picked clean, nothing left but the bones. Detective's ruling: JT has been living on ramen since the rent went up.",
   "text": "Rorschach's journal. October 31st. 17:39. JT sees an animal skull. Hollow, picked clean, nothing left but the bones. Detective's ruling: JT has been living on ramen since the rent went up.",
   "audioUrl": "/archive-audio/8206517216947-c3ork6.mp3"
  },
  {
   "id": "8206518041067-uxnu44",
   "createdAt": "2026-10-31T21:25:58.932Z",
   "stamp": "Rorschach's journal. October 31st. 17:25.",
   "line": "Gavin sees a meditator with the whole town flipped upside down. Inner peace at any cost, and the cost is everyone else. Breathe, Gavin. Somebody has to right this city.",
   "text": "Rorschach's journal. October 31st. 17:25. Gavin sees a meditator with the whole town flipped upside down. Inner peace at any cost, and the cost is everyone else. Breathe, Gavin. Somebody has to right this city.",
   "audioUrl": "/archive-audio/8206518041067-uxnu44.mp3"
  },
  {
   "id": "8206518253411-92w5ef",
   "createdAt": "2026-10-31T21:22:26.588Z",
   "stamp": "Rorschach's journal. October 31st. 17:22.",
   "line": "Mark sees a bull skull and two exclamation points, the most bull on the page. Bleached by the desert, still charging at every argument. Case closed, Mark.",
   "text": "Rorschach's journal. October 31st. 17:22. Mark sees a bull skull and two exclamation points, the most bull on the page. Bleached by the desert, still charging at every argument. Case closed, Mark.",
   "audioUrl": "/archive-audio/8206518253411-92w5ef.mp3"
  },
  {
   "id": "8206520672106-45uaie",
   "createdAt": "2026-10-31T20:42:07.893Z",
   "stamp": "Rorschach's journal. October 31st. 16:42.",
   "line": "Hamza sees a Pokémon and can't remember its name. Diagnosis: a trainer who left the starter in the tall grass. The Pokédex has logged you as unknown, Hamza.",
   "text": "Rorschach's journal. October 31st. 16:42. Hamza sees a Pokémon and can't remember its name. Diagnosis: a trainer who left the starter in the tall grass. The Pokédex has logged you as unknown, Hamza.",
   "audioUrl": "/archive-audio/8206520672106-45uaie.mp3"
  },
  {
   "id": "8206533435846-g0oi8k",
   "createdAt": "2026-10-31T17:09:24.153Z",
   "stamp": "Rorschach's journal. October 31st. 13:09.",
   "line": "Zuned sees meiosis. Two divisions, four cells, zero identical copies. Case closed: Zuned is avoiding the family reunion again.",
   "text": "Rorschach's journal. October 31st. 13:09. Zuned sees meiosis. Two divisions, four cells, zero identical copies. Case closed: Zuned is avoiding the family reunion again.",
